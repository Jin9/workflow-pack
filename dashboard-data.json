  "tests": [
    {
      "name": "Unit — Backend",
      "level": "unit",
      "on": "be.artifacts · CI",
      "runner": "executing-backend-unit-tests",
      "metric": "pass/fail + coverage %",
      "threshold": "0 fail · coverage ≥ 0.80",
      "gate": "auto",
      "note": "runner removed 2026-06-02 — unused by pipeline"
    },
    {
      "name": "Unit — Frontend",
      "level": "unit",
      "on": "fe.artifacts · CI",
      "runner": "executing-frontend-unit-tests",
      "metric": "pass/fail + per-file coverage %",
      "threshold": "0 fail · coverage ≥ threshold",
      "gate": "auto",
      "note": "runner removed 2026-06-02 — unused by pipeline",
      "star": true
    },
    {
      "name": "Integration",
      "level": "integration",
      "on": "post-impl · SIT",
      "runner": "executing-integration-tests",
      "metric": "pass/fail + teardown integrity",
      "threshold": "0 fail · teardown_ok=true",
      "gate": "auto+exc",
      "note": "runner removed 2026-06-02 — unused by pipeline"
    },
    {
      "name": "Contract (Pact / CDCT)",
      "level": "contract",
      "on": "pre-merge · can-i-deploy · CI",
      "runner": "contract-testing-pact",
      "metric": "provider verification + can-i-deploy",
      "threshold": "all pacts verify · can_i_deploy=true",
      "gate": "auto",
      "note": "runner removed 2026-06-02 — unused by pipeline"
    },
    {
      "name": "End-to-end (E2E)",
      "level": "e2e",
      "on": "post-deploy · SIT/UAT",
      "runner": "authoring-e2e-test-suite",
      "metric": "scenario pass/fail + flaky rate",
      "threshold": "0 journey/assertion fail",
      "gate": "auto+exc",
      "note": "runner removed 2026-06-02 — unused by pipeline",
      "star": true
    },
    {
      "name": "Security — SAST / code (BOLA·IDOR·secrets)",
      "level": "security",
      "on": "pre-merge · CI",
      "runner": "running-sast-security-gate",
      "metric": "findings by severity + secrets + new-vs-baseline",
      "threshold": "0 secrets · 0 new ≥ severity",
      "gate": "auto",
      "note": "runner removed 2026-06-02 — unused by pipeline",
      "star": true
    },
    {
      "name": "Security — DAST / SCA / secrets-scan",
      "level": "security",
      "on": "CI · SIT",
      "runner": "scanning-appsec-pipeline-gate",
      "metric": "DAST/SCA findings + CVE + secrets",
      "threshold": "0 secrets · 0 known-exploited CVE · 0 new ≥ severity",
      "gate": "auto",
      "note": "runner removed 2026-06-02 — unused by pipeline",
      "star": true
    },
    {
      "name": "Security — adversarial / pentest (OWASP·chaos)",
      "level": "security",
      "on": "pre-deploy · UAT",
      "runner": "validating-banking-implementation (persona)",
      "metric": "adversarial persona findings",
      "threshold": "persona judgment (no machine threshold)",
      "gate": "human",
      "note": "runner removed 2026-06-02 — unused by pipeline",
      "star": true
    },
    {
      "name": "Performance / Load",
      "level": "performance",
      "on": "pre-prod · staging/UAT",
      "runner": "running-performance-load-test",
      "metric": "p95 · p99 · error-rate · throughput",
      "threshold": "all within budget",
      "gate": "auto",
      "note": "runner removed 2026-06-02 — unused by pipeline",
      "star": true
    },
    {
      "name": "Accessibility (WCAG 2.1 AA)",
      "level": "a11y",
      "on": "FE review · SIT",
      "runner": "running-accessibility-tests",
      "metric": "WCAG AA violations + manual checks",
      "threshold": "0 AA violations",
      "gate": "auto+exc",
      "note": "runner removed 2026-06-02 — unused (OI-004 open)"
    },
    {
      "name": "Smoke / sanity",
      "level": "smoke",
      "on": "post-deploy · PRD",
      "runner": "running-smoke-tests",
      "metric": "probe pass/fail + latency",
      "threshold": "all probes green",
      "gate": "auto",
      "note": "runner removed 2026-06-02 — unused by pipeline"
    },
    {
      "name": "Canary analysis",
      "level": "progressive",
      "on": "post-deploy · PRD",
      "runner": "analyzing-canary-rollout",
      "metric": "per-metric vs baseline + sample adequacy",
      "threshold": "success ≥ 95% over 3 windows · sample adequate",
      "gate": "auto+exc",
      "note": "runner removed 2026-06-02 — unused by pipeline"
    },
    {
      "name": "SLO validation (prod)",
      "level": "slo",
      "on": "post-deploy · PRD",
      "runner": "validating-production-slo",
      "metric": "multi-window error-budget burn-rate",
      "threshold": "burn ≤ 14.4×/1h · 6×/6h · 3×/24h",
      "gate": "auto+exc",
      "note": "wired in delivery-pipeline.yaml (S7)"
    }
  ],
