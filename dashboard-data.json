{
  "tier": {
    "T1": "T1",
    "T2": "T2",
    "T3": "T3"
  },
  "stages": [
    {
      "id": "S0",
      "name": "Intake",
      "skill": "orchestrator + Iteration-Planner",
      "owner": "Delivery Ops",
      "model": "Opus 4.8 / Gemini 3.1 Pro",
      "tier": "T1",
      "gate": "auto",
      "input": "raw_request · requester · idempotency_key",
      "output": "normalized intake + run plan",
      "contract": "pipeline-input + run-plan",
      "json": "full",
      "verify": true,
      "reviewDoc": "Run plan",
      "caps": "—",
      "schema": "pipeline-input (raw_request, requester, idempotency_key)",
      "fail": "GAP — unowned stage (OI-003)",
      "deferred": true,
      "tip": "Normalizes the raw ask and produces an approved run plan. Currently <b>deferred / unowned (OI-003)</b>."
    },
    {
      "id": "S1a",
      "name": "BA Discovery",
      "skill": "researching-ba-problem-space 1.0.0",
      "owner": "BA lead",
      "model": "Opus 4.8",
      "tier": "T1",
      "gate": "async",
      "input": "raw_request",
      "output": "discovery (problem framing · 4 product risks · regulatory regimes · recommendation)",
      "contract": "discovery.json → [human gate on recommendation: proceed | needs-work | do-not-build]",
      "json": "full",
      "verify": true,
      "reviewDoc": "Discovery review doc (problem-space layer)",
      "caps": "human-queue (ba-discovery-review) · max_retries 0",
      "schema": "discovery.json",
      "fail": "regulatory hard-blocker → human gate; recommendation ≠ proceed → blocks S1b",
      "tip": "<b>S1a · Problem-space extraction (YAML node <code>s1-discovery</code>).</b> <b>researching-ba-problem-space</b> drafts a discovery artifact: problem framing · opportunities · the four product risks · regulatory regimes · a <b>proceed / needs-work / do-not-build</b> recommendation. <b>AI drafts; a named human decides</b> on that recommendation (the supervision gate). Only <b>proceed</b> releases S1b — <code>needs-work</code> loops back, <code>do-not-build</code> stops the pipeline. This gate is the irreversible-decision boundary, surfaced as its own card."
    },
    {
      "id": "S1b",
      "name": "BA Brief",
      "skill": "eliciting-banking-brief 1.5.0",
      "owner": "BA lead",
      "model": "Opus 4.8",
      "tier": "T1",
      "gate": "async",
      "input": "discovery + raw_request",
      "output": "epics (EPIC-*) · stories (STORY-*) · governance_gaps",
      "contract": "ba-brief.json INDEX → EPIC-* files (story refs) → STORY-* files",
      "json": "manifest",
      "verify": true,
      "reviewDoc": "Four-layer pack · one unified HTML viewer",
      "caps": "retry 2 → human-queue (delivery-failures)",
      "schema": "ba-brief.json (manifest → epic refs → STORY-* files)",
      "fail": "brief: transient→retry; governance P1→human (never auto-resolve)",
      "tip": "<b>S1b · Epics & stories (YAML node <code>ba-research</code>; id preserved so downstream refs are untouched).</b> On <b>proceed</b>, <b>eliciting-banking-brief</b> takes the discovery (advisory) and splits the requirement into <b>one EPIC-* file per epic</b>, each referencing its <b>STORY-* story files</b> (one per story, under the epic; <b>nothing inlined</b>). Machine handoff is a <b>4-layer ref chain</b>: INDEX manifest → discovery + brief → epic files (story refs) → story files (load only what you need). Human-view = a single self-contained offline <b>HTML viewer</b> rendering all four layers (discovery · brief · epics · stories). <b>Governance/P1 blockers escalate to a human</b>, never auto-resolved."
    },
    {
      "id": "S1.5",
      "name": "UX Intake",
      "skill": "generate-ux-pack 0.1.0",
      "owner": "Tech Lead",
      "model": "Opus 4.8",
      "tier": "T2",
      "gate": "async",
      "input": "epic · stories",
      "output": "tokens · route_map · maturity",
      "contract": "ux-intake.json (+ pack files)",
      "json": "full",
      "verify": true,
      "reviewDoc": "UX pack maturity report",
      "caps": "retry 1 → human-queue (ux-intake-pending)",
      "schema": "ux-intake.json",
      "fail": "transient→retry; else human-queue",
      "tip": "Produces design tokens, route map and a maturity level for the UI work."
    },
    {
      "id": "S2",
      "name": "TL Design",
      "skill": "designing-tech-lead-handoff 0.1.0",
      "owner": "Tech Lead",
      "model": "Opus 4.8 / GPT-5.5",
      "tier": "T1",
      "gate": "sync",
      "input": "epic · stories · gaps · ux",
      "output": "component_map · api_contracts",
      "contract": "tl-design.json (+ ADR docs)",
      "json": "full",
      "verify": true,
      "reviewDoc": "TL Design doc + ADRs",
      "caps": "no retry → human-queue (tl-design-pending)",
      "schema": "tl-design.json",
      "fail": "no auto-retry — design ripples to N components, so a human owns it",
      "tip": "Architecture + API contracts + component map. <b>T1: L3 sync named approval</b> — TL decisions ripple to every downstream component."
    },
    {
      "id": "S2.5",
      "name": "Plan-Review gate",
      "skill": "Plan-Reviewer (adversarial red-team)",
      "owner": "Tech Lead",
      "model": "GPT-5.5 / Opus 4.8",
      "tier": "T1",
      "gate": "gate",
      "input": "BA + TL outputs",
      "output": "pass / reroute / HardFail + findings",
      "contract": "plan-review.json",
      "json": "full",
      "verify": true,
      "reviewDoc": "Plan-review findings",
      "caps": "cap 1 per diagnosis → HardFail",
      "schema": "plan-review.json",
      "fail": "reroute high to BA/TL; cap exceeded → HardFail (no fan-out)",
      "tip": "Red-teams the BA+TL plan <b>before</b> the expensive fan-out. Cheap to reverse, but high blast radius if a bad plan fans out — so it gates. Human reviews on HardFail."
    },
    {
      "id": "S3a/3b",
      "name": "Contracts (BE/FE)",
      "skill": "dev-squad",
      "owner": "dev-squad",
      "model": "GPT-5.5 / Opus 4.8",
      "tier": "T2",
      "gate": "auto",
      "input": "api_contracts",
      "output": "API paths · events · request/response (typed BE/FE contracts)",
      "contract": "OpenAPI / typed JSON",
      "json": "full",
      "verify": false,
      "reviewDoc": "",
      "caps": "—",
      "schema": "(deferred)",
      "fail": "GAP — unowned stage (OI-003)",
      "deferred": true,
      "tip": "Splits contracts into typed backend/frontend boundaries. Currently <b>deferred (OI-003)</b>."
    },
    {
      "id": "S4a",
      "name": "Backend Impl",
      "skill": "implement-backend-feature 1.0.0",
      "owner": "dev-squad",
      "model": "Sonnet 4.6 → Opus 4.8",
      "tier": "T2",
      "gate": "auto",
      "input": "api_contracts · component_map",
      "output": "go_files · test_files",
      "contract": "backend-artifacts.json + Go code",
      "json": "manifest",
      "verify": false,
      "reviewDoc": "",
      "caps": "retry 2 → backend-implement-failures",
      "schema": "backend-artifacts.json",
      "fail": "transient→retry; runs in sandbox (ALLOW: tests-in-sandbox)",
      "tip": "Generates Go service code + tests <b>in a sandbox</b>. Reversible — auto-gated. Output is code referenced by a JSON manifest."
    },
    {
      "id": "S4a-r",
      "name": "Backend Review",
      "skill": "review-backend-code 1.0.0",
      "owner": "dev-squad",
      "model": "Opus 4.8",
      "tier": "T2",
      "gate": "async",
      "input": "go_files · contracts",
      "output": "verdict · findings",
      "contract": "backend-review.json",
      "json": "full",
      "verify": true,
      "reviewDoc": "Backend review report",
      "caps": "loop_back ↔ Dev, max_loops 2",
      "schema": "backend-review.json",
      "fail": "high/medium route back to Dev (cap 2); low → ADVISORY",
      "tip": "Severity-graded review. <b>An agent never approves its own code</b> — review identity is separate from impl identity; human async-confirms the verdict."
    },
    {
      "id": "S4b",
      "name": "Frontend Impl",
      "skill": "implement-frontend-feature 1.0.0",
      "owner": "dev-squad",
      "model": "Opus 4.8",
      "tier": "T2",
      "gate": "auto",
      "input": "api_contracts · ux pack",
      "output": "tsx_files · test_files",
      "contract": "frontend-artifacts.json + TSX code",
      "json": "manifest",
      "verify": false,
      "reviewDoc": "",
      "caps": "retry 2 → frontend-implement-failures",
      "schema": "frontend-artifacts.json",
      "fail": "transient→retry; sandboxed",
      "tip": "Generates Next.js / TSX code + tests in a sandbox. Output is code referenced by a JSON manifest."
    },
    {
      "id": "S4b-r",
      "name": "Frontend Review",
      "skill": "review-frontend-code 1.0.0",
      "owner": "dev-squad",
      "model": "Opus 4.8",
      "tier": "T2",
      "gate": "async",
      "input": "tsx_files · contracts",
      "output": "verdict · findings",
      "contract": "frontend-review.json",
      "json": "full",
      "verify": true,
      "reviewDoc": "Frontend review report",
      "caps": "loop_back ↔ Dev, max_loops 2",
      "schema": "frontend-review.json",
      "fail": "high/medium route back to Dev (cap 2); low → ADVISORY",
      "tip": "Quality + security review of the UI; routes findings by severity; human async-confirms the verdict."
    },
    {
      "id": "S4c",
      "name": "QA Test Design",
      "skill": "planning-banking-tests 1.0.0",
      "owner": "qa-squad",
      "model": "GPT-5.5 / Opus 4.8",
      "tier": "T2",
      "gate": "sync",
      "input": "epic · stories · review verdicts",
      "output": "test_roster · signoff_criteria",
      "contract": "qa-plan.json",
      "json": "full",
      "verify": true,
      "reviewDoc": "Test plan & sign-off criteria",
      "caps": "retry 2 → human-queue",
      "schema": "qa-plan.json",
      "fail": "L3 sync on conditional-go; else retry→human-queue",
      "tip": "Maps business logic to a test roster + sign-off criteria. <b>Conditional-go → L3 sync named approval.</b>"
    },
    {
      "id": "S5",
      "name": "QA Validation",
      "skill": "qa-squad (execute)",
      "owner": "qa-squad",
      "model": "Opus 4.8 / Gemini 3.1 Pro",
      "tier": "T1",
      "gate": "sync",
      "input": "test_roster",
      "output": "pass/fail evidence",
      "contract": "qa-evidence (pass/fail)",
      "json": "full",
      "verify": true,
      "reviewDoc": "QA evidence report",
      "caps": "—",
      "schema": "(deferred)",
      "fail": "GAP — execution node missing (OI-003 / GAP-05)",
      "deferred": true,
      "tip": "Executes the test roster and produces pass/fail evidence. Currently <b>deferred — only test design exists, not execution</b>."
    },
    {
      "id": "S6",
      "name": "Deploy",
      "skill": "handoff-to-deploy 0.1.0 → release",
      "owner": "Release Manager",
      "model": "Gemini 3.1 Pro",
      "tier": "T1",
      "gate": "sync",
      "input": "signoff_criteria",
      "output": "receipt_id + LIVE RELEASE",
      "contract": "handoff-receipt.json",
      "json": "full",
      "verify": true,
      "reviewDoc": "Release runbook + KNOWN_ISSUES + sign-off packet",
      "caps": "no retry; compensate via handoff-revoke (600s)",
      "schema": "handoff-receipt.json",
      "fail": "IRREVERSIBLE — mandatory sync named approval; skill missing (OI-002)",
      "deferred": true,
      "tip": "<b>IRREVERSIBLE / control-plane.</b> Requires <b>synchronous named-human approval regardless of agent confidence</b>. Skill + approver are a GAP (OI-002). Credentials must be short-lived OIDC tokens."
    },
    {
      "id": "S7",
      "name": "Prod Validation",
      "skill": "ops + observability",
      "owner": "On-call / Release Mgr",
      "model": "GPT-5.5 / Gemini 3.1 Pro",
      "tier": "T2",
      "gate": "sync",
      "input": "live release",
      "output": "smoke/SLO verdict + rollback decision",
      "contract": "smoke/SLO metrics + rollback record",
      "json": "full",
      "verify": true,
      "reviewDoc": "Smoke/SLO report + rollback decision record",
      "caps": "—",
      "schema": "(deferred)",
      "fail": "GAP — unowned (OI-003); named rollback decision required",
      "deferred": true,
      "tip": "Smoke + SLO check on the live release with a <b>named human rollback decision</b>. Currently <b>deferred (OI-003)</b>."
    }
  ],
  "events": {
    "S0": {
      "consumes": ["raw_request"],
      "emits": "intake.normalized",
      "sdlc": "Requirements & Design"
    },
    "S1a": {
      "consumes": ["raw_request"],
      "emits": "ba.discovery",
      "sdlc": "Requirements & Design"
    },
    "S1b": {
