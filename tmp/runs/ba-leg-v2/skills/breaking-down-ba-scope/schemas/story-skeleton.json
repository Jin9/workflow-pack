{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://squad-delivery/skills/breaking-down-ba-scope/schemas/story-skeleton.json",
  "title": "ba-breakdown story skeleton (STORY-PREFIX-NN.json)",
  "description": "A story BEFORE elaboration. Deliberately shallow: what the story is, which rules and flows it realises, how big it looks and what it depends on. No acceptance criteria and no banking-grade rows - those are written by elaborating-user-stories AFTER the three-amigos gate agrees this breakdown is right. A skeleton that already carried AC would defeat the point of the gate.",
  "type": "object",
  "required": ["id", "epic_id", "title", "format", "card", "intent", "rule_refs", "flow_refs", "priority", "sizing"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^STORY-[A-Z0-9-]+-\\d+$" },
    "epic_id": { "type": "string", "pattern": "^EPIC-[A-Z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "format": { "type": "string", "enum": ["classic_user_story", "job_story", "spike"] },
    "card": {
      "type": "object",
      "required": ["as_a", "i_want", "so_that"],
      "additionalProperties": false,
      "properties": {
        "as_a": { "type": "string", "minLength": 1 },
        "i_want": { "type": "string", "minLength": 1 },
        "so_that": { "type": "string", "minLength": 12, "description": "INVEST-V: a concrete outcome, not 'so I can use the system'." }
      }
    },
    "intent": {
      "type": "string",
      "minLength": 20,
      "maxLength": 300,
      "description": "ONE line: what changes in the business when this ships. Capped so the skeleton stays scannable in the three-amigos session."
    },
    "rule_refs": {
      "type": "array",
      "description": "The business rules this story must honour. MUST be non-empty for a non-spike story: a story that realises no rule is either a rule the catalogue is missing or a story that should not exist.",
      "items": { "type": "string", "pattern": "^RULE-[A-Z0-9-]+-\\d+$" }
    },
    "flow_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^FLOW-[A-Z0-9-]+$" }
    },
    "entity_refs": { "type": "array", "items": { "type": "string", "pattern": "^ENTITY-[A-Z0-9-]+$" } },
    "priority": { "type": "string", "enum": ["Must", "Should", "Could", "Won't"] },
    "sizing": {
      "type": "object",
      "required": ["story_points", "complexity", "split_required"],
      "additionalProperties": false,
      "properties": {
        "story_points": { "oneOf": [{ "type": "integer", "enum": [1, 2, 3, 5, 8, 13] }, { "type": "string", "const": "TBD_by_TL" }] },
        "complexity": { "type": "string", "enum": ["low", "medium", "high"] },
        "split_required": { "type": "boolean" }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "depends_on": { "type": "array", "items": { "type": "string" } },
        "blocks": { "type": "array", "items": { "type": "string" } }
      }
    },
    "open_question_refs": { "type": "array", "items": { "type": "string", "pattern": "^OQ-\\d+$" } },
    "requirement_refs": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "format": { "not": { "const": "spike" } } }, "required": ["format"] },
      "then": { "properties": { "rule_refs": { "minItems": 1 } } }
    },
    {
      "if": { "properties": { "sizing": { "properties": { "story_points": { "const": 13 } }, "required": ["story_points"] } }, "required": ["sizing"] },
      "then": { "properties": { "sizing": { "properties": { "split_required": { "const": true } } } } }
    }
  ]
}
