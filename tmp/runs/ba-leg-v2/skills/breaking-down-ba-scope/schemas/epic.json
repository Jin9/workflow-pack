{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://squad-delivery/skills/breaking-down-ba-scope/schemas/epic.json",
  "title": "ba-breakdown epic file (EPIC-NAME.json)",
  "description": "One epic in the breakdown pack. The `decoupling` block is the audit trail for the business-dependency grouping rule: an epic exists only because it passed all three tests, and any candidate that failed test 3 is recorded in merged_from rather than silently dropped.",
  "type": "object",
  "required": ["id", "title", "story_prefix", "problem_statement", "business_value", "success_criteria", "decoupling", "scope", "inferred_tier", "story_refs"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "pattern": "^EPIC-[A-Z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "story_prefix": { "type": "string", "pattern": "^[A-Z0-9]+$" },
    "problem_statement": { "type": "string", "minLength": 1 },
    "business_value": {
      "type": "string",
      "minLength": 20,
      "description": "What a business audience gets when THIS epic alone ships. Test 1 of the decoupling rule is judged against this sentence."
    },
    "why_now": { "type": "string" },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["metric", "target"],
        "additionalProperties": true,
        "properties": {
          "metric": { "type": "string" },
          "baseline": { "type": "string" },
          "target": { "type": "string" },
          "measurement_method": { "type": "string" }
        }
      }
    },
    "decoupling": {
      "type": "object",
      "required": ["independently_valuable", "own_success_metric", "sibling_dependencies", "rationale"],
      "additionalProperties": true,
      "properties": {
        "independently_valuable": { "type": "boolean", "description": "Test 1 - a business audience gets value from this epic alone." },
        "own_success_metric": { "type": "boolean", "description": "Test 2 - at least one success_criteria row that is not another epic's metric." },
        "sibling_dependencies": {
          "type": "array",
          "description": "Test 3 - epic ids this epic cannot deliver value without, for BUSINESS reasons (not technical sequencing). MUST be empty: a non-empty list means the epics should have been merged.",
          "maxItems": 0,
          "items": { "type": "string" }
        },
        "rationale": { "type": "string", "minLength": 20, "description": "Why this is one epic and not two, or two and not one." },
        "merged_from": {
          "type": "array",
          "description": "Candidate epics folded in because they failed test 3. Enablers (auth, inventory, notification) appear here, never as epics.",
          "items": { "type": "string" }
        },
        "split_axis": {
          "type": "string",
          "enum": ["workflow-step", "business-rule-variation", "data-variation", "role-boundary", "happy-vs-alternate", "crud", "optimize-later", "spike", "none"],
          "description": "When a merged epic exceeded the story cap and had to be split, the VALUE axis used. Never a technical layer (AP-7.1)."
        }
      }
    },
    "scope": {
      "type": "object",
      "required": ["in"],
      "additionalProperties": true,
      "properties": {
        "in": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "out_explicit": { "type": "array", "items": { "type": "string" } },
        "out_deferred": { "type": "array", "items": { "type": "string" } }
      }
    },
    "stakeholders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role"],
        "additionalProperties": true,
        "properties": {
          "role": { "type": "string" },
          "name_or_team": { "type": "string" },
          "raci": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    },
    "legal_status": { "type": "string", "enum": ["present", "scheduled", "mentioned_only", "absent"] },
    "inferred_tier": { "type": "string", "enum": ["T1", "T2", "T3"] },
    "tier_signals": { "type": "array", "items": { "type": "string" } },
    "inferred_higher_than_manual": { "type": "boolean", "description": "AP-1.3 - set when the inferred tier exceeds the supplied hint or floor by at least one step; requires a human override." },
    "rule_refs": { "type": "array", "items": { "type": "string", "pattern": "^RULE-[A-Z0-9-]+-\\d+$" } },
    "flow_refs": { "type": "array", "items": { "type": "string", "pattern": "^FLOW-[A-Z0-9-]+$" } },
    "story_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "file"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "pattern": "^STORY-[A-Z0-9-]+-\\d+$" },
          "file": { "type": "string", "description": "Epic-file-relative POSIX ref to the story skeleton." },
          "title": { "type": "string" }
        }
      }
    }
  }
}
