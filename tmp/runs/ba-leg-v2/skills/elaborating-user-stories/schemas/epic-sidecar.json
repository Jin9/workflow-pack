{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://squad-delivery/skills/elaborating-user-stories/schemas/epic-sidecar.json",
  "title": "elaborated epic sidecar (EPIC-NAME.json)",
  "description": "The breakdown's epic carried forward with its story_refs pointing at elaborated sidecars. The REQUIRED set is unchanged from the predecessor skill's epic sidecar so downstream consumer contracts keep validating; business_value and the decoupling audit trail are additive and travel with the epic so the Tech Lead can see WHY these are the epics. Elaboration never re-groups epics - a regrouping means the breakdown changed and the three-amigos gate has to see it again.",
  "type": "object",
  "required": ["id", "title", "problem_statement", "success_criteria", "scope", "stakeholders", "inferred_tier", "story_refs"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "pattern": "^EPIC-[A-Z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "story_prefix": { "type": "string", "pattern": "^[A-Z0-9]+$" },
    "problem_statement": { "type": "string", "minLength": 1 },
    "business_value": { "type": "string", "minLength": 20 },
    "why_now": { "type": "string" },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["metric", "target"],
        "additionalProperties": true,
        "properties": {
          "metric": { "type": "string" },
          "baseline": { "type": "string" },
          "target": { "type": "string" },
          "measurement_method": { "type": "string" }
        }
      }
    },
    "decoupling": {
      "type": "object",
      "description": "Carried forward verbatim from the breakdown. Read-only here.",
      "additionalProperties": true,
      "properties": {
        "independently_valuable": { "type": "boolean" },
        "own_success_metric": { "type": "boolean" },
        "sibling_dependencies": { "type": "array", "maxItems": 0, "items": { "type": "string" } },
        "rationale": { "type": "string" },
        "merged_from": { "type": "array", "items": { "type": "string" } },
        "split_axis": { "type": "string" }
      }
    },
    "scope": {
      "type": "object",
      "required": ["in"],
      "additionalProperties": true,
      "properties": {
        "in": { "type": "array", "items": { "type": "string" } },
        "out_explicit": { "type": "array", "items": { "type": "string" } },
        "out_deferred": { "type": "array", "items": { "type": "string" } }
      }
    },
    "stakeholders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role"],
        "additionalProperties": true,
        "properties": {
          "role": { "type": "string" },
          "name_or_team": { "type": "string" },
          "raci": { "type": "string" },
          "status": { "type": "string" },
          "engagement_required_for": { "type": "string" }
        }
      }
    },
    "legal_status": { "type": "string", "enum": ["present", "scheduled", "mentioned_only", "absent"] },
    "inferred_tier": { "type": "string", "enum": ["T1", "T2", "T3"] },
    "tier_signals": { "type": "array", "items": { "type": "string" } },
    "rule_refs": { "type": "array", "items": { "type": "string", "pattern": "^RULE-[A-Z0-9-]+-\\d+$" } },
    "flow_refs": { "type": "array", "items": { "type": "string", "pattern": "^FLOW-[A-Z0-9-]+$" } },
    "story_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "file"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "pattern": "^STORY-[A-Z0-9-]+-\\d+$" },
          "slug": { "type": "string" },
          "file": { "type": "string" },
          "title": { "type": "string" }
        }
      }
    }
  }
}
