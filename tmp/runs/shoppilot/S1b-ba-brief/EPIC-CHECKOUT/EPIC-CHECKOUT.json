{
  "id": "EPIC-CHECKOUT",
  "title": "Server-side checkout and mock payment",
  "problem_statement": "Customers must be able to pay for a cart at a total the system computes (never a tampered client value), with shipping and coupon rules applied, and the order must not double-charge or oversell when clicks or provider callbacks are duplicated.",
  "why_now": "Checkout is the revenue path; it depends on auth and gates orders and inventory.",
  "hypothesis": "Server-computed totals plus idempotent confirm and provider-replay dedup give a correct, replay-safe money path on a mock provider that swaps cleanly for a real PSP later.",
  "success_criteria": [
    {
      "metric": "client-trusted total incidents",
      "baseline": "n/a",
      "target": "0 (all totals server-computed)",
      "measurement_method": "checkout integration tests"
    },
    {
      "metric": "double-charge / double-reserve on duplicate signal",
      "baseline": "n/a",
      "target": "0",
      "measurement_method": "idempotency + provider-replay tests"
    }
  ],
  "scope": {
    "in": [
      "server-side total computation",
      "shipping rule (free >= 1500 THB else 60 THB)",
      "one coupon, floored at 0",
      "coupon re-validation at confirm",
