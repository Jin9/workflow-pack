{
  "$schema": "https://design-tokens.org/draft",
  "$description": "ShopPilot UX-design tokens (W3C Design Tokens draft). [SIM maturity-2] brand tokens now concrete (BA-derived MVP palette); contrast computed via WCAG 2.1 relative-luminance.",
  "color": {
    "brand": {
      "primary": {
        "$type": "color",
        "$value": "#0B5FD8",
        "$extensions": {
          "contrast": {
            "vs-white": "5.63:1",
            "wcagAA": true,
            "wcagAAA": false,
            "usage_note": "Primary action text/fill behind white text (AA normal+large)."
          }
        }
      },
      "secondary": {
        "$type": "color",
        "$value": "#E8590C",
        "$extensions": {
          "contrast": {
            "vs-white": "4.52:1",
            "wcagAA": true,
            "wcagAAA": false,
            "usage_note": "Accent/large-text only on white."
          }
        }
      }
    },
    "text": {
      "primary": {
        "$type": "color",
        "$value": "#1A1A1A",
        "$extensions": {
          "contrast": {
            "vs-white": "17.40:1",
            "wcagAA": true,
            "wcagAAA": true,
            "usage_note": "Default body text on page/surface."
          }
        }
      },
      "secondary": {
        "$type": "color",
        "$value": "#595959",
        "$extensions": {
          "contrast": {
            "vs-white": "7.00:1",
            "wcagAA": true,
            "wcagAAA": true,
            "usage_note": "Secondary text/labels on white."
          }
        }
      },
      "tertiary": {
        "$type": "color",
        "$value": "#6E6E6E",
        "$extensions": {
          "contrast": {
            "vs-white": "5.10:1",
            "wcagAA": true,
            "wcagAAA": false,
            "usage_note": "Hints/placeholders ≥16px only (AA normal, not AAA)."
          }
        }
      }
    },
    "background": {
      "page": {
        "$type": "color",
        "$value": "#FFFFFF"
      },
      "surface": {
        "$type": "color",
        "$value": "#F4F4F5",
        "$extensions": {
          "contrast": {
            "vs-text-primary": "15.83:1",
            "usage_note": "Card/surface fill; not a text color."
          }
        }
      },
      "divider": {
        "$type": "color",
        "$value": "#E0E0E2"
      }
    },
    "semantic": {
      "success": {
        "$type": "color",
        "$value": "#197A3D",
        "$extensions": {
          "contrast": {
            "vs-white": "5.39:1",
            "wcagAA": true,
            "wcagAAA": false,
            "usage_note": "Confirmation text/icons on white."
          }
        }
      },
      "warning": {
        "$type": "color",
        "$value": "#8A5300",
        "$extensions": {
          "contrast": {
            "vs-white": "6.33:1",
            "wcagAA": true,
            "wcagAAA": false,
            "usage_note": "Warning text on white (not as fill behind white text)."
          }
        }
      },
      "error": {
        "$type": "color",
        "$value": "#B3261E",
        "$extensions": {
          "contrast": {
            "vs-white": "6.54:1",
            "wcagAA": true,
            "wcagAAA": false,
            "usage_note": "Validation/error text on white."
          }
        }
      },
      "info": {
        "$type": "color",
        "$value": "#1A5FB4",
        "$extensions": {
          "contrast": {
            "vs-white": "6.29:1",
            "wcagAA": true,
            "wcagAAA": false,
            "usage_note": "Informational text/links on white."
          }
        }
      }
    }
  },
  "spacing": {
    "xs": {
      "$type": "dimension",
      "$value": "4px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "8px"
    },
    "md": {
      "$type": "dimension",
      "$value": "16px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "24px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "32px"
    },
    "page-padding": {
      "$type": "dimension",
      "$value": "16px"
    },
    "page-padding-compact": {
      "$type": "dimension",
      "$value": "12px"
    },
    "card-gap": {
      "$type": "dimension",
      "$value": "12px"
    },
    "section-gap": {
      "$type": "dimension",
      "$value": "24px"
    }
  },
  "typography": {
    "font-family-default": {
      "$type": "fontFamily",
      "$value": "system-ui, -apple-system, 'Noto Sans Thai', sans-serif"
    },
    "font-family-alternates": {
      "$type": "fontFamily",
      "$value": "system-ui, -apple-system, 'Noto Sans Thai', sans-serif"
    },
    "scale-100": {
      "$type": "dimension",
      "$value": "12px"
    },
    "scale-200": {
      "$type": "dimension",
      "$value": "14px"
    },
    "scale-300": {
      "$type": "dimension",
      "$value": "16px"
    },
    "scale-400": {
      "$type": "dimension",
      "$value": "18px"
    },
    "scale-500": {
      "$type": "dimension",
      "$value": "20px"
    },
    "scale-600": {
      "$type": "dimension",
      "$value": "24px"
    },
    "scale-700": {
      "$type": "dimension",
      "$value": "30px"
    },
    "scale-800": {
      "$type": "dimension",
      "$value": "36px"
    },
    "scale-900": {
      "$type": "dimension",
      "$value": "48px"
    },
    "font-weight-regular": {
      "$type": "fontWeight",
      "$value": 400
    },
    "font-weight-medium": {
      "$type": "fontWeight",
      "$value": 500
    },
    "font-weight-semibold": {
      "$type": "fontWeight",
      "$value": 600
    },
    "font-weight-bold": {
      "$type": "fontWeight",
      "$value": 700
    }
  },
  "radius": {
    "card": {
      "$type": "dimension",
      "$value": "8px"
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px"
    },
    "button": {
      "$type": "dimension",
      "$value": "8px"
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "$value": "200ms"
    }
  }
}
