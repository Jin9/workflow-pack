
# Environment

# ENV controls log mode and environment-aware features.
# Values: LOCAL, DEV, SIT, UAT, PROD
ENV=LOCAL


# Server

HOSTNAME=localhost
PORT=8080


# Access Control (CORS)

ACCESS_CONTROL_ALLOW_ORIGIN=*


# Header

REF_ID_HEADER_KEY=X-Ref-Id


# JWT

JWT_ISSUER=example-service-mgmt
JWT_AUDIENCE=example-service
JWT_EXP_DURATION=24h


# GCP Firestore

GCP_PROJECT_ID=your-project-id
GCP_CREDENTIALS_JSON=
GCP_FIRESTORE_DATABASE_ID=(default)
GCP_FIRESTORE_CONNECT_TIMEOUT=30s


# Google OAuth2

GOOGLE_OAUTH2_VERIFY_TOKEN=https://oauth2.googleapis.com/tokeninfo
GOOGLE_OAUTH2_GET_USER_PROFILE=https://openidconnect.googleapis.com/v1/userinfo
GOOGLE_OAUTH2_REVOKE_TOKEN=https://oauth2.googleapis.com/revoke


# Secrets (base64-encoded where noted)

SECRET_JWT_PRIVATE_KEY=                  # base64-encoded EC private key (ES256)
SECRET_AESGCM_KEY=                       # 32-byte hex AES-GCM key
SECRET_HASH_PEPPER=                      # bcrypt pepper
SECRET_DB_USERNAME=appusr
SECRET_DB_PASSWORD=
SECRET_REDIS_PASSWORD=


# HTTP Client
HTTP_CLIENT_ENABLE_LOG_DEBUG=false


# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=platform_mgmt

# Redis
REDIS_ADDR=localhost:6379

# Leave empty to skip consumer startup.
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=platform-mgmt
KAFKA_TOPICS=platform-events
KAFKA_OFFSETS_INITIAL=latest
KAFKA_REBALANCE_STRATEGY=range

# Leave empty if this service does not produce.
KAFKA_PRODUCER_BROKERS=localhost:9092
