{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://squad-delivery/skills/elaborating-user-stories/schemas/output.json",
  "title": "elaborated brief INDEX manifest (stage artifact of ba-research)",
  "description": "The 3-level ref-chain manifest the elaboration stage emits: INDEX -> epic sidecars -> story sidecars, plus the carried-forward rule, domain and flow refs so tl-design, contract-design and qa-plan can pick them up. DELIBERATELY boundary-compatible with workflows/schemas/ba-brief.json: the required set (epics, story_files, governance_gaps, state, audit_id) and the item shapes are unchanged, so splitting S1b into breakdown plus elaboration is invisible to all five downstream consumers.",
  "type": "object",
  "required": ["audit_id", "stage", "state", "produced_by", "epics", "story_files", "governance_gaps", "count_check"],
  "additionalProperties": true,
  "properties": {
    "audit_id": {
      "type": "string",
      "format": "uuid",
      "description": "UUIDv5(HOUSE_NS, 'ba-research:{idempotency_key}'). Unchanged from the predecessor skill so recorded corpus provenance stays valid. Distinct from breakdown.audit_id, which is recorded in upstream_refs."
    },
    "stage": { "type": "string", "const": "ba-research" },
    "state": {
      "type": "string",
      "enum": ["ready-for-tl", "needs-work", "blocked"],
      "description": "TL readiness signal; tl-design's pre-flight requires ready-for-tl."
    },
    "produced_by": { "type": "string", "minLength": 1 },
    "idempotency_key": { "type": "string" },
    "epics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "file", "title"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "pattern": "^EPIC-[A-Z0-9-]+$" },
          "file": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "slug": { "type": "string" },
          "story_ids": { "type": "array", "items": { "type": "string", "pattern": "^STORY-[A-Z0-9-]+-\\d+$" } }
        }
      }
    },
    "story_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "epic_id", "file", "title"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "pattern": "^STORY-[A-Z0-9-]+-\\d+$" },
          "epic_id": { "type": "string", "pattern": "^EPIC-[A-Z0-9-]+$" },
          "file": { "type": "string" },
          "title": { "type": "string", "minLength": 1 },
          "slug": { "type": "string" },
          "priority": { "type": "string", "enum": ["Must", "Should", "Could", "Won't"] }
        }
      }
    },
    "rules_file": { "type": "string", "description": "Carried forward from the breakdown pack unchanged - elaboration never edits a rule." },
    "domain_file": { "type": "string", "description": "Carried forward unchanged." },
    "flows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "file", "name"],
        "additionalProperties": true,
        "properties": { "id": { "type": "string" }, "file": { "type": "string" }, "name": { "type": "string" } }
      }
    },
    "governance_gaps": { "type": "array", "items": { "type": "object" } },
    "open_questions": { "type": "array", "items": { "type": "object" } },
    "assumptions_made": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["assumption", "why_made"],
        "additionalProperties": true,
        "properties": {
          "assumption": { "type": "string" },
          "why_made": { "type": "string" },
          "provenance": { "type": "string", "enum": ["prose_ambiguity", "hidden_frame_sweep"] },
          "frame": { "type": "integer", "minimum": 1, "maximum": 10 },
          "default_revisit_trigger": { "type": "string" }
        }
      }
    },
    "rule_coverage": {
      "type": "object",
      "description": "The rule-anchored edge-case sweep's ledger: which rules got which derived cases. A rule with zero covered cases is a visible gap, not an omission.",
      "required": ["rules_total", "rules_covered", "uncovered_rule_ids", "transitions_total", "illegal_transition_cases"],
      "additionalProperties": true,
      "properties": {
        "rules_total": { "type": "integer", "minimum": 0 },
        "rules_covered": { "type": "integer", "minimum": 0 },
        "uncovered_rule_ids": { "type": "array", "items": { "type": "string" } },
        "transitions_total": { "type": "integer", "minimum": 0 },
        "illegal_transition_cases": { "type": "integer", "minimum": 0 },
        "open_rule_ids": { "type": "array", "items": { "type": "string" }, "description": "Rules the breakdown flagged open; stories referencing them cannot reach ready-for-tl." }
      }
    },
    "hidden_requirements_sweep": {
      "type": "object",
      "required": ["frames_applied", "frames_skipped", "coverage_score"],
      "additionalProperties": true,
      "properties": {
        "frames_applied": { "type": "array", "items": { "type": "integer" } },
        "frames_skipped": { "type": "array", "items": { "type": "integer" } },
        "frames_skipped_reasons": { "type": "object" },
        "findings_per_frame": { "type": "object" },
        "cap_exceptions": { "type": "object" },
        "total_findings": { "type": "integer", "minimum": 0 },
        "coverage_score": { "type": "string", "enum": ["complete", "partial", "skipped"] }
      }
    },
    "count_check": {
      "type": "object",
      "required": ["epics", "stories", "acceptance_criteria"],
      "additionalProperties": true,
      "properties": {
        "epics": { "type": "integer", "minimum": 1 },
        "stories": { "type": "integer", "minimum": 1 },
        "acceptance_criteria": { "type": "integer", "minimum": 1 },
        "open_questions": { "type": "integer", "minimum": 0 }
      }
    },
    "upstream_refs": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "source_artifacts": { "type": "array", "items": { "type": "string" } },
        "breakdown_audit_id": { "type": "string" },
        "discovery_audit_id": { "type": "string" },
        "amigos_approvers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "failure_state": {
      "type": "object",
      "required": ["failure_code", "reason"],
      "additionalProperties": true,
      "properties": {
        "failure_code": {
          "type": "string",
          "enum": ["breakdown_not_agreed", "governance_p1_unresolved", "open_rule_blocks_story", "untestable_criteria", "schema_validation_failure", "pii_echo_blocked"]
        },
        "reason": { "type": "string", "minLength": 10 },
        "blocking_items": { "type": "array", "items": { "type": "string" } },
        "suggested_next_action": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "ready-for-tl" } }, "required": ["state"] },
      "then": {
        "properties": {
          "rule_coverage": { "properties": { "uncovered_rule_ids": { "maxItems": 0 }, "open_rule_ids": { "maxItems": 0 } } },
          "hidden_requirements_sweep": { "properties": { "coverage_score": { "const": "complete" } } }
        },
        "required": ["rule_coverage", "hidden_requirements_sweep"]
      }
    },
    {
      "if": { "properties": { "state": { "enum": ["blocked", "needs-work"] } }, "required": ["state"] },
      "then": { "required": ["failure_state"] }
    }
  ]
}
