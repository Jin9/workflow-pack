{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "scanning-appsec-pipeline-gate output",
  "type": "object",
  "required": ["verdict", "secrets", "audit_id"],
  "additionalProperties": false,
  "properties": {
    "verdict": { "type": "string", "enum": ["PASS", "FAIL", "ERROR"] },
    "dast_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "summary"],
        "additionalProperties": false,
        "properties": {
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
          "summary": { "type": "string", "description": "Runtime finding summary; secrets redacted as PII:REDACTED." }
        }
      }
    },
    "sca_cves": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "known_exploited"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "description": "CVE identifier for a known vulnerability in an imported dependency." },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
          "known_exploited": { "type": "boolean", "description": "True if actively exploited in the wild; always a hard fail." }
        }
      }
    },
    "secrets": { "type": "integer", "minimum": 0, "description": "Count of detected secrets; any non-zero is a hard fail." },
    "audit_id": { "type": "string", "format": "uuid" }
  }
}
