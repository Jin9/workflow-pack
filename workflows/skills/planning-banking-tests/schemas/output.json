{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://skillify-treasury/skills/planning-banking-tests/schemas/output.json",
  "title": "planning-banking-tests output v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["output_type", "blocks_qa_execution", "frontmatter", "processing_metadata"],
  "properties": {
    "output_type": {
      "type": "string",
      "enum": ["test_plan", "blocked_test_plan", "partial_test_plan", "failure_shape"]
    },
    "blocks_qa_execution": { "type": "boolean" },
    "frontmatter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test_plan_id", "brief_id", "brief_idempotency_key", "idempotency_key", "workload_tier", "created_at", "created_by", "status"],
      "properties": {
        "test_plan_id": { "type": "string", "minLength": 1 },
        "brief_id": { "type": "string", "minLength": 1 },
        "brief_idempotency_key": { "type": "string" },
        "idempotency_key": { "type": "string" },
        "workload_tier": { "type": "string", "enum": ["T1", "T2", "T3"] },
        "created_at": { "type": "string", "format": "date-time" },
        "created_by": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["ready-for-execution", "blocked", "draft"] }
      }
    },
    "scope_kind": { "type": "string", "enum": ["single-epic", "multi-epic"] },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test_pyramid_allocation", "tier_rationale", "mock_vs_real_strategy", "high_risk_areas"],
      "properties": {
        "test_pyramid_allocation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unit_pct", "integration_pct", "e2e_pct"],
          "properties": {
            "unit_pct": { "type": "number", "minimum": 0, "maximum": 100 },
            "integration_pct": { "type": "number", "minimum": 0, "maximum": 100 },
            "e2e_pct": { "type": "number", "minimum": 0, "maximum": 100 },
            "contract_pct": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        },
        "tier_rationale": { "type": "string", "minLength": 1 },
        "mock_vs_real_strategy": { "type": "string", "minLength": 1 },
        "high_risk_areas": { "type": "array", "items": { "type": "string" } }
      }
    },
    "epics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["epic_id", "test_tier", "critical_paths", "stakeholder_owners"],
        "properties": {
          "epic_id": { "type": "string", "minLength": 1 },
          "test_tier": { "type": "string", "enum": ["T1", "T2", "T3"] },
          "critical_paths": { "type": "array", "items": { "type": "string" } },
          "stakeholder_owners": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "stories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["story_id", "epic_id", "test_case_ids", "coverage_status"],
        "properties": {
          "story_id": { "type": "string", "minLength": 1 },
          "epic_id": { "type": "string", "minLength": 1 },
          "test_case_ids": { "type": "array", "items": { "type": "string" } },
          "coverage_status": { "type": "string", "enum": ["complete", "partial", "blocked"] },
          "blocking_oqs": { "type": "array", "items": { "type": "string" } },
          "qa_effort_estimate": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sdet_hours", "manual_hours", "perf_hours", "compliance_hours"],
            "properties": {
              "sdet_hours": { "type": "number", "minimum": 0 },
              "manual_hours": { "type": "number", "minimum": 0 },
              "perf_hours": { "type": "number", "minimum": 0 },
              "compliance_hours": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "test_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "story_id", "scenario_ref", "scenario_type", "test_type", "pyramid_level", "owner", "environment_ref", "tags", "risk_level", "expected_assertions", "reviewer_role", "smoke_subset_member"],
        "properties": {
          "id": { "type": "string", "pattern": "^TC-[A-Za-z0-9_.-]+-[0-9]{3}$" },
          "story_id": { "type": "string", "minLength": 1 },
          "scenario_ref": { "type": "string", "minLength": 1 },
          "scenario_type": { "type": "string", "enum": ["happy", "error", "edge_case", "boundary", "banking_grade_audit", "banking_grade_idempotency", "banking_grade_authz", "banking_grade_reversibility", "banking_grade_tipping_off", "banking_grade_notification", "regulatory", "nfr"] },
          "test_type": { "type": "string", "enum": ["functional", "integration", "e2e", "contract", "performance", "security", "compliance", "accessibility", "exploratory", "regression"] },
          "pyramid_level": { "type": "string", "enum": ["unit", "integration", "contract", "e2e"] },
          "owner": { "type": "string", "minLength": 1 },
          "test_data_refs": { "type": "array", "items": { "type": "string" } },
          "environment_ref": { "type": "string", "minLength": 1 },
          "depends_on_test_cases": { "type": "array", "items": { "type": "string" } },
          "tags": { "type": "array", "items": { "type": "string" } },
          "risk_level": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
          "expected_assertions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "description"],
              "properties": {
                "type": { "type": "string", "minLength": 1 },
                "description": { "type": "string", "minLength": 1 }
              }
            }
          },
          "compliance_tags": { "type": "array", "items": { "type": "string" } },
          "reviewer_role": { "type": "string", "minLength": 1 },
          "quarantine_policy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["quarantine_until_date", "reason"],
            "properties": {
              "quarantine_until_date": { "type": "string", "format": "date" },
              "reason": { "type": "string", "minLength": 1 }
            }
          },
          "smoke_subset_member": { "type": "boolean" }
        }
      }
    },
    "smoke_subset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_clock_budget_seconds", "test_case_ids"],
      "properties": {
        "wall_clock_budget_seconds": { "type": "integer", "minimum": 1 },
        "test_case_ids": { "type": "array", "items": { "type": "string", "pattern": "^TC-[A-Za-z0-9_.-]+-[0-9]{3}$" } }
      }
    },
    "coverage_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["by_story", "by_scenario_type", "by_pyramid_level", "by_tier"],
      "properties": {
        "by_story": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "by_scenario_type": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "by_pyramid_level": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "by_tier": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
      }
    },
    "nfr_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "epic_id", "nfr_type", "metric", "target"],
        "properties": {
          "id": { "type": "string", "pattern": "^NFR-[A-Za-z0-9_.-]+-(perf|sec|a11y|reliab|obs|data)-[0-9]{3}$" },
          "epic_id": { "type": "string", "minLength": 1 },
          "nfr_type": { "type": "string", "enum": ["performance", "scalability", "availability", "security", "accessibility", "observability", "resilience", "data-integrity", "latency", "throughput"] },
          "metric": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1, "description": "Target value, or 'TBD pending OQ-N' when blocked by unresolved BA OQ (AP-Q9)." },
          "blocking_oqs": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "compliance_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "regulator_code", "test_type", "scope"],
        "properties": {
          "id": { "type": "string", "pattern": "^COMP-[A-Z0-9_]+-[0-9]{3}$" },
          "regulator_code": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "test_type": { "type": "string", "minLength": 1 },
          "scope": { "type": "string", "minLength": 1 },
          "compliance_scope_blocked": { "type": "boolean" },
          "blocking_governance_gaps": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "execution_dag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "test_case_ref"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "test_case_ref": { "type": "string", "minLength": 1 },
              "label": { "type": "string" }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to"],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "kind": { "type": "string", "enum": ["data", "ordering", "fixture", "env"] }
            }
          }
        }
      }
    },
    "environments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "purpose"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "required_mocks": { "type": "array", "items": { "type": "string" } },
          "real_services": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "test_data_specs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fixture_set_id", "pii_field_refs", "synthesis_rules"],
        "properties": {
          "fixture_set_id": { "type": "string", "minLength": 1 },
          "pii_field_refs": { "type": "array", "items": { "type": "string" } },
          "synthesis_rules": { "type": "string", "minLength": 1 },
          "time_anchors": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "signoff_criteria": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "go_conditions", "conditional_go_conditions", "no_go_conditions"],
      "properties": {
        "tier": { "type": "string", "enum": ["T1", "T2", "T3"] },
        "go_conditions": { "type": "array", "items": { "type": "string" } },
        "conditional_go_conditions": { "type": "array", "items": { "type": "string" } },
        "no_go_conditions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "coverage_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "severity", "description", "required_action", "escalation_target"],
        "properties": {
          "type": { "type": "string", "enum": ["missing-scenario", "missing-fixture", "missing-env", "missing-nfr-target", "missing-compliance", "missing-tl-design", "ambiguous-requirement", "banking_grade_no_test", "qa_blocking_governance_gap"] },
          "severity": { "type": "string", "enum": ["P1", "P2", "P3"] },
          "story_id": { "type": "string" },
          "description": { "type": "string", "minLength": 1 },
          "required_action": { "type": "string", "minLength": 1 },
          "escalation_target": { "type": "string", "enum": ["BA", "TL", "Legal", "Compliance", "QA-Lead"] }
        }
      }
    },
    "qa_readiness_checklist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all_stories_have_test_cases", "all_banking_grade_applies_have_tests", "all_nfr_targets_resolved", "all_compliance_regulators_covered", "all_dependencies_have_test_envs", "no_blocking_ba_governance_gaps"],
      "properties": {
        "all_stories_have_test_cases": { "type": "boolean" },
        "all_banking_grade_applies_have_tests": { "type": "boolean" },
        "all_nfr_targets_resolved": { "type": "boolean" },
        "all_compliance_regulators_covered": { "type": "boolean" },
        "all_dependencies_have_test_envs": { "type": "boolean" },
        "no_blocking_ba_governance_gaps": { "type": "boolean" }
      }
    },
    "tl_design_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "needed_by_test_cases", "description"],
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "needed_by_test_cases": { "type": "array", "items": { "type": "string" } },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "processing_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ba_brief_version", "ba_brief_idempotency_key", "tier_decisions", "scenario_mapping_table_version", "pyramid_allocation_rules_version", "tl_design_consumed", "environment_inventory_consumed", "role_boundaries"],
      "properties": {
        "ba_brief_version": { "type": "string", "minLength": 1 },
        "ba_brief_idempotency_key": { "type": "string" },
        "tier_decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "tier", "rationale"],
            "properties": {
              "target": { "type": "string" },
              "tier": { "type": "string", "enum": ["T1", "T2", "T3"] },
              "rationale": { "type": "string" }
            }
          }
        },
        "scenario_mapping_table_version": { "type": "string" },
        "pyramid_allocation_rules_version": { "type": "string" },
        "tl_design_consumed": { "type": "boolean" },
        "environment_inventory_consumed": { "type": "boolean" },
        "role_boundaries": {
          "type": "array",
          "description": "DOCUMENTATION ONLY at v1.0.0. Annotates which logical QA role owns which sections, for v1.1+ fan-out evolution. Not load-bearing. See references/v1.1-role-boundaries.md.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "owns_sections"],
            "properties": {
              "role": { "type": "string", "enum": ["qa-strategist", "test-designer", "nfr-engineer", "compliance-mapper", "fixture-architect", "signoff-officer", "coverage-auditor", "security-tester", "performance-engineer", "accessibility-tester", "environment-owner"] },
              "owns_sections": { "type": "array", "items": { "type": "string" } },
              "notes": { "type": "string" }
            }
          }
        }
      }
    },
    "failure_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failure_code", "message", "remediation"],
      "properties": {
        "failure_code": { "type": "string", "enum": ["ba_brief_not_found", "ba_brief_invalid", "blocked_test_plan_dor", "blocked_test_plan_governance", "schema_validation_failure", "tipping_off_violation", "tier_downgrade_warning", "internal_error"] },
        "message": { "type": "string", "minLength": 1 },
        "remediation": { "type": "string", "minLength": 1 },
        "blocking_evidence": { "type": "array", "items": { "type": "string" } },
        "validation_errors": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "output_type": { "const": "test_plan" },
        "blocks_qa_execution": { "const": false }
      },
      "required": ["scope_kind", "strategy", "epics", "stories", "test_cases", "smoke_subset", "coverage_matrix", "nfr_tests", "compliance_tests", "execution_dag", "environments", "test_data_specs", "signoff_criteria", "qa_readiness_checklist"]
    },
    {
      "properties": {
        "output_type": { "const": "blocked_test_plan" },
        "blocks_qa_execution": { "const": true }
      },
      "required": ["coverage_gaps"]
    },
    {
      "properties": {
        "output_type": { "const": "partial_test_plan" },
        "blocks_qa_execution": { "const": true }
      },
      "required": ["epics", "stories", "test_cases", "coverage_gaps"]
    },
    {
      "properties": {
        "output_type": { "const": "failure_shape" },
        "blocks_qa_execution": { "const": true }
      },
      "required": ["failure_state"]
    }
  ],
  "allOf": [
    {
      "$comment": "Invariant 1: ready-for-execution implies blocks_qa_execution=false AND no P1 coverage_gaps. Encoded.",
      "if": {
        "properties": {
          "frontmatter": {
            "properties": { "status": { "const": "ready-for-execution" } },
            "required": ["status"]
          }
        },
        "required": ["frontmatter"]
      },
      "then": {
        "allOf": [
          { "properties": { "blocks_qa_execution": { "const": false } } },
          {
            "not": {
              "properties": {
                "coverage_gaps": {
                  "type": "array",
                  "contains": {
                    "properties": { "severity": { "const": "P1" } },
                    "required": ["severity"]
                  }
                }
              },
              "required": ["coverage_gaps"]
            }
          }
        ]
      }
    },
    { "$comment": "Invariant 2: Every BA banking_grade_applies row must have >=1 test_case with matching tag. Cross-document; renderer-enforced." },
    { "$comment": "Invariant 3: Every regulator in BA regulatory_dependencies[] must appear as >=1 compliance_tests[].regulator_code. Cross-document; renderer-enforced." },
    { "$comment": "Invariant 4: Every PII field in BA pii_inventory[] must be referenced by >=1 test_data_specs[].pii_field_refs. Cross-document; renderer-enforced." }
  ]
}
