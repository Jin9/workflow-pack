{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://squad-delivery/skills/designing-tech-lead-handoff/schemas/output.json",
  "title": "designing-tech-lead-handoff output contract",
  "description": "Authoritative output contract for the designing-tech-lead-handoff stage (the system-design BLUEPRINT: bounded contexts, integration contracts, component map, infra topology, ADRs, and the consolidated offline L1-L4 architecture diagram). Per-service API specs, per-story L4 implementation specs, and the event catalog are OUT OF SCOPE — a separate detailed-design concern (see audit/RATIONALE.md). The pipeline-boundary schema workflows/schemas/tl-design.json is a permissive superset of this one (it enforces only required_fields: component_map, api_contracts, audit_id). additionalProperties:false everywhere except contract payload_shape (free-form per tech-lead-contracts template). oneOf discriminator on output_type: design / partial_design / blocked_design. api_contracts and component_map shapes are lifted byte-faithful from templates/tech-lead-contracts.md and templates/tech-lead-components.md so backend/frontend implement+review stages consume them unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "output_type",
    "audit_id",
    "processing_metadata"
  ],
  "properties": {
    "output_type": {
      "type": "string",
      "enum": [
        "design",
        "partial_design",
        "blocked_design"
      ]
    },
    "component_map": {
      "type": "object",
      "additionalProperties": false,
      "description": "Verbatim shape of templates/tech-lead-components.md embedded schema. dependencies[] MUST resolve to api_contracts.contracts[].contract_name (referential integrity enforced at runtime by tests/assertions/contract-completeness.md — not expressible in draft-07).",
      "required": [
        "template_version",
        "components"
      ],
      "properties": {
        "template_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "component_name",
              "required",
              "complexity",
              "dependencies",
              "parallel_safe"
            ],
            "properties": {
              "component_name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "required": {
                "type": "boolean"
              },
              "complexity": {
                "type": "string",
                "enum": [
                  "simple",
                  "standard",
                  "complex"
                ]
              },
              "complexity_rationale": {
                "type": "string",
                "minLength": 1
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "parallel_safe": {
                "type": "boolean"
              },
              "microservice_split_threshold": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "api_contracts": {
      "type": "object",
      "additionalProperties": false,
      "description": "Verbatim shape of templates/tech-lead-contracts.md embedded schema. These are the cross-component INTERFACE contracts (the architecture's connective tissue), NOT per-service endpoint specs. payload_shape is intentionally open (free-form JSON-Schema-ish object per the template).",
      "required": [
        "template_version",
        "contracts"
      ],
      "properties": {
        "template_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "contracts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "contract_name",
              "payload_shape",
              "semantics",
              "idempotency_rules",
              "failure_modes",
              "ordering_guarantees",
              "contract_version"
            ],
            "properties": {
              "contract_name": {
                "type": "string",
                "minLength": 1
              },
              "payload_shape": {
                "type": "object"
              },
              "semantics": {
                "type": "string",
                "enum": [
                  "sync",
                  "async",
                  "system_internal"
                ]
              },
              "idempotency_rules": {
                "type": "string",
                "minLength": 1
              },
              "failure_modes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "ordering_guarantees": {
                "type": "string",
                "minLength": 1
              },
              "contract_version": {
                "type": "string",
                "pattern": "^\\d+\\.\\d+\\.\\d+$"
              },
              "provider_component": {
                "type": "string",
                "description": "Optional: the component (from component_map) providing this contract. Not in frozen corpus entries; live designs SHOULD emit it."
              },
              "consumer_components": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Optional: consuming components, resolving against component_map. Live designs SHOULD emit it."
              },
              "async_channel": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "topic": {
                    "type": "string"
                  },
                  "event_type": {
                    "type": "string"
                  },
                  "partition_key": {
                    "type": "string"
                  }
                },
                "description": "Optional structured channel data for async contracts (topic, event type, partition key)."
              }
            }
          }
        }
      }
    },
    "infra_summary": {
      "$ref": "#/definitions/MdArtifact"
    },
    "infra_topology": {
      "$ref": "#/definitions/MdArtifact"
    },
    "connectivity": {
      "$ref": "#/definitions/MdArtifact"
    },
    "observability_spec": {
      "$ref": "#/definitions/MdArtifact"
    },
    "adrs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "slug",
          "path",
          "content",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ADR-\\d{3}$"
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "path": {
            "type": "string",
            "pattern": "^design/architecture/ADRs/ADR-\\d{3}-[a-z0-9-]+\\.md$"
          },
          "content": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "Proposed",
              "Accepted",
              "Deprecated",
              "Superseded"
            ]
          },
          "supersedes": {
            "type": "string",
            "pattern": "^ADR-\\d{3}$"
          }
        }
      }
    },
    "diagrams": {
      "type": "object",
      "additionalProperties": false,
      "description": "OPTIONAL. The consolidated 5-tab architecture .drawio (L1-L4 + Legend) + its source spec, produced at step 7 by scripts/spec_to_drawio.py. Present-or-absent, never null. A stricter subset of the boundary schema workflows/schemas/tl-design.json diagrams block, so any valid output also satisfies the boundary. erd_consolidated points at the SAME file (its L4 page is the ER pack).",
      "required": [
        "architecture_drawio",
        "architecture_spec",
        "offline"
      ],
      "properties": {
        "architecture_drawio": {
          "type": "string",
          "pattern": "\\.drawio$"
        },
        "architecture_spec": {
          "type": "string",
          "pattern": "\\.spec\\.json$"
        },
        "erd_consolidated": {
          "type": "string",
          "pattern": "\\.drawio$"
        },
        "sequence_diagrams": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\.drawio$"
          }
        },
        "offline": {
          "type": "boolean",
          "const": true
        }
      }
    },
    "data_model": {
      "type": "object",
      "additionalProperties": false,
      "description": "OPTIONAL. Emit ONLY once the per-service split ER pack exists — its INDEX is mandatory (mirrors boundary workflows/schemas/tl-design.json, which requires `index`). Until then the consolidated ER is carried by diagrams.erd_consolidated, and this block is omitted. Present-or-absent, never null.",
      "required": [
        "index"
      ],
      "properties": {
        "index": {
          "type": "string"
        },
        "consolidated_erd_drawio": {
          "type": "string",
          "pattern": "\\.drawio$"
        },
        "service_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "coverage_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "detail"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "ba_story_without_ux_route",
              "ux_route_without_ba_story",
              "contract_without_consumer"
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "architecture_smells": {
      "type": "array",
      "description": "Result of the scaffold-v1.1 §5 self-audit. Every status:fail MUST carry resolution:revised or resolution:adr with adr_ref.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check",
          "status",
          "resolution"
        ],
        "properties": {
          "check": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail"
            ]
          },
          "resolution": {
            "type": "string",
            "enum": [
              "revised",
              "adr",
              "n/a"
            ]
          },
          "adr_ref": {
            "type": "string",
            "pattern": "^ADR-\\d{3}$"
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "question",
          "why_matters",
          "suggested_resolver"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^OQ-\\d+$"
          },
          "severity": {
            "type": "string",
            "enum": [
              "P1",
              "P2",
              "P3"
            ]
          },
          "question": {
            "type": "string",
            "minLength": 12
          },
          "why_matters": {
            "type": "string",
            "minLength": 20
          },
          "suggested_resolver": {
            "type": "string"
          }
        }
      }
    },
    "blocking_findings": {
      "type": "array",
      "description": "Present on output_type=partial_design (artifacts produced but contract-incomplete: FM-TL-03/04).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "detail",
          "owner"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string"
          }
        }
      },
      "minItems": 1
    },
    "blockers": {
      "type": "array",
      "description": "Present on output_type=blocked_design (pre-architecture stop: bad BA gate or missing UX contract).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "description"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "remediation": {
            "type": "string"
          }
        }
      }
    },
    "audit_id": {
      "type": "string",
      "format": "uuid",
      "description": "Producer-stamped deterministic provenance id: UUIDv5(HOUSE_NS, \"tl-design:{idempotency_key}\") with HOUSE_NS = uuid5(NAMESPACE_URL, \"https://squad-delivery/audit\"). Distinct from the engine's per-attempt execution audit id."
    },
    "processing_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skill_name",
        "skill_version",
        "started_at",
        "completed_at",
        "tier",
        "mode"
      ],
      "properties": {
        "skill_name": {
          "type": "string",
          "const": "designing-tech-lead-handoff"
        },
        "skill_version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "description": "SemVer of the producing skill; equals the skill frontmatter version at production time (historical artifacts keep their original producer version)."
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "tier": {
          "type": "string",
          "enum": [
            "T1",
            "T2",
            "T3"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "full"
          ]
        },
        "idempotency_key": {
          "type": "string",
          "format": "uuid"
        },
        "ba_brief_status_seen": {
          "type": "string"
        },
        "contexts_derived": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "description": "design — system-design blueprint. The three pipeline-mandated fields plus the architecture artifact set (contracts, components, 4 infra docs, ADRs).",
      "properties": {
        "output_type": {
          "const": "design"
        }
      },
      "required": [
        "output_type",
        "component_map",
        "api_contracts",
        "infra_summary",
        "infra_topology",
        "connectivity",
        "observability_spec",
        "adrs",
        "audit_id",
        "processing_metadata"
      ]
    },
    {
      "description": "partial_design — artifacts produced but a contract/dependency gate failed. Carries the blueprint (component_map + api_contracts) PLUS non-empty blocking_findings so the named-human gate can adjudicate it.",
      "properties": {
        "output_type": {
          "const": "partial_design"
        }
      },
      "required": [
        "output_type",
        "api_contracts",
        "audit_id",
        "blocking_findings",
        "component_map",
        "processing_metadata"
      ]
    },
    {
      "description": "blocked_design — pre-architecture stop (diagnostic failure artifact). INTENTIONALLY fails the stage boundary (which requires component_map + api_contracts) and routes to the tl-design-pending human queue; carries non-empty blockers[].",
      "properties": {
        "output_type": {
          "const": "blocked_design"
        }
      },
      "required": [
        "output_type",
        "audit_id",
        "processing_metadata",
        "blockers"
      ]
    }
  ],
  "definitions": {
    "MdArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "content"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^design/architecture/.+\\.md$"
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  }
}
