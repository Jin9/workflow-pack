{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "validating-banking-implementation output",
  "type": "object",
  "required": ["verdict", "audit_id"],
  "additionalProperties": false,
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["pass", "conditional", "fail"],
      "description": "Advisory persona-judgment verdict; a named human confirms it at the gate."
    },
    "persona_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["persona", "severity", "scenario", "evidence"],
        "additionalProperties": false,
        "properties": {
          "persona": { "type": "string", "description": "Adversarial persona that surfaced the finding." },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
          "scenario": { "type": "string", "description": "OWASP or chaos scenario exercised." },
          "evidence": { "type": "string", "description": "Reproduction / evidence; real PII or secrets redacted as PII:REDACTED." }
        }
      }
    },
    "audit_id": { "type": "string", "format": "uuid" }
  }
}
