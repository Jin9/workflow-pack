{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "running-accessibility-tests output",
  "type": "object",
  "required": [
    "verdict",
    "wcag_violations",
    "needs_review",
    "manual_checks",
    "execution",
    "scan_scope",
    "standard",
    "audit_id"
  ],
  "additionalProperties": false,
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "ERROR"
      ]
    },
    "wcag_violations": {
      "type": "array",
      "description": "Machine-decidable AA failures from the a11y engine.",
      "items": {
        "type": "object",
        "required": [
          "impact",
          "rule",
          "targets",
          "wcag_ref"
        ],
        "additionalProperties": false,
        "properties": {
          "rule": {
            "type": "string"
          },
          "impact": {
            "type": "string",
            "enum": [
              "critical",
              "serious",
              "moderate",
              "minor"
            ]
          },
          "wcag_ref": {
            "type": "string",
            "minLength": 1
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "needs_review": {
      "type": "array",
      "description": "Engine 'incomplete' items the automation cannot decide; require a human.",
      "items": {
        "type": "object",
        "required": [
          "note",
          "rule",
          "targets"
        ],
        "additionalProperties": false,
        "properties": {
          "rule": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "targets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "manual_checks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "audit_id": {
      "type": "string",
      "format": "uuid",
      "description": "Producer-stamped provenance id. LIVE derivation: UUIDv5(HOUSE_NS, \"accessibility-tests:{idempotency_key}\"), HOUSE_NS = uuid5(NAMESPACE_URL, \"https://squad-delivery/audit\") \u2014 distinct from the per-attempt audit id in events.jsonl. (Reference-corpus ids use the grandfathered corpus convention.)"
    },
    "execution": {
      "type": "object",
      "description": "Execution provenance \u2014 how this gate evidence was produced. replay = byte-verbatim reference corpus (no scan ran); runner = a real scan ran in this run.",
      "required": [
        "mode",
        "target_source"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "runner",
            "replay"
          ]
        },
        "target_source": {
          "type": "string",
          "enum": [
            "current-run",
            "reference-corpus"
          ]
        },
        "runner": {
          "type": "string",
          "minLength": 1
        },
        "engine": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Run-relative path to the raw runner report."
        },
        "report_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "runner"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "runner",
              "evidence_ref",
              "report_sha256"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "replay"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "target_source": {
                "const": "reference-corpus"
              }
            }
          }
        }
      ]
    },
    "scan_scope": {
      "type": "object",
      "required": [
        "targets_scanned"
      ],
      "additionalProperties": false,
      "properties": {
        "targets_scanned": {
          "type": "integer",
          "minimum": 0,
          "description": "Count of files/pages/components the scan covered (derived from the manifest in replay)."
        }
      }
    },
    "standard": {
      "type": "object",
      "required": [
        "name",
        "version",
        "level"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "WCAG"
        },
        "version": {
          "const": "2.1"
        },
        "level": {
          "const": "AA"
        }
      },
      "description": "This stage is unambiguously the WCAG 2.1 AA gate \u2014 the standard is stamped, not configurable."
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Diagnostics \u2014 required non-empty on ERROR. Redact PII as [PII:REDACTED:CLASS=...]."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "PASS"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "wcag_violations": {
            "maxItems": 0
          },
          "needs_review": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "FAIL"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "anyOf": [
          {
            "properties": {
              "wcag_violations": {
                "minItems": 1
              }
            }
          },
          {
            "properties": {
              "needs_review": {
                "minItems": 1
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "ERROR"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "required": [
          "errors"
        ],
        "properties": {
          "errors": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
