{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "handoff-revoke output",
  "type": "object",
  "required": ["revoke_id", "original_receipt_id", "status", "audit_id"],
  "additionalProperties": false,
  "properties": {
    "revoke_id": { "type": "string", "description": "Identifier of this compensation record." },
    "original_receipt_id": { "type": "string", "description": "The handoff receipt that was reversed." },
    "status": { "type": "string", "enum": ["revoked", "partial", "blocked"] },
    "audit_id": { "type": "string", "format": "uuid" }
  }
}
