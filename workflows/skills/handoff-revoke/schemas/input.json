{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "handoff-revoke input",
  "type": "object",
  "required": ["receipt_id", "reason", "idempotency_key"],
  "additionalProperties": false,
  "properties": {
    "receipt_id": { "type": "string", "description": "The handoff-to-deploy receipt to reverse." },
    "reason": { "type": "string", "description": "Why the handoff is being revoked (audit-visible)." },
    "confirmer": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "description": "Named human confirming the revoke.",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" }
      }
    },
    "tier": { "type": "string", "enum": ["T1", "T2", "T3"], "default": "T1" },
    "idempotency_key": { "type": "string" }
  }
}
