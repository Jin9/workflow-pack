{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://squad-delivery/skills/eliciting-banking-brief/schemas/epic-sidecar.json",
  "title": "ba-brief epic sidecar (EPIC-<DOMAIN>.json)",
  "description": "Target-owned schema for one rendered epic sidecar file in the ba-brief ref-chain. This is the exact object consumers receive inline in `epics[]` after engine hydration (mapping.py _hydrate_ba_research) — downstream input contracts reference THIS shape, never inline byte-copies.",
  "type": "object",
  "required": ["id", "title", "problem_statement", "success_criteria", "scope", "stakeholders", "inferred_tier", "story_refs"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "pattern": "^EPIC-[A-Z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "problem_statement": { "type": "string", "minLength": 1 },
    "why_now": { "type": "string" },
    "hypothesis": { "type": "string" },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["metric", "target"],
        "additionalProperties": true,
        "properties": {
          "metric": { "type": "string" },
          "baseline": { "type": "string" },
          "target": { "type": "string" },
          "measurement_method": { "type": "string" }
        }
      }
    },
    "scope": {
      "type": "object",
      "required": ["in"],
      "additionalProperties": true,
      "properties": {
        "in": { "type": "array", "items": { "type": "string" } },
        "out_explicit": { "type": "array", "items": { "type": "string" } },
        "out_deferred": { "type": "array", "items": { "type": "string" } }
      }
    },
    "stakeholders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role"],
        "additionalProperties": true,
        "properties": {
          "role": { "type": "string" },
          "name_or_team": { "type": "string" },
          "raci": { "type": "string" },
          "type": { "type": "string" },
          "decision_authority": { "type": "string" }
        }
      }
    },
    "legal_status": { "type": "string" },
    "inferred_tier": { "type": "string", "enum": ["T1", "T2", "T3"] },
    "tier_signals": { "type": "array", "items": { "type": "object" } },
    "story_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "file"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "pattern": "^STORY-[A-Z0-9-]+-\\d+$" },
          "slug": { "type": "string" },
          "file": { "type": "string", "description": "Epic-sidecar-relative POSIX ref to the story sidecar." },
          "title": { "type": "string" }
        }
      }
    },
    "change_log": { "type": "array", "items": { "type": "object" } }
  }
}
