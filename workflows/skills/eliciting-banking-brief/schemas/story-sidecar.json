{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://squad-delivery/skills/eliciting-banking-brief/schemas/story-sidecar.json",
  "title": "ba-brief story sidecar (STORY-<DOMAIN>-NN-<slug>.json)",
  "description": "Target-owned schema for one rendered story sidecar file in the ba-brief ref-chain. This is the exact object consumers receive inline in the engine-ADDED `stories[]` key after hydration (mapping.py _hydrate_ba_research) — downstream input contracts reference THIS shape, never inline byte-copies.",
  "type": "object",
  "required": ["id", "epic_id", "title", "format", "card", "acceptance_criteria", "banking_grade_concerns", "priority"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "pattern": "^STORY-[A-Z0-9-]+-\\d+$" },
    "epic_id": { "type": "string", "pattern": "^EPIC-[A-Z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "format": { "type": "string" },
    "card": {
      "type": "object",
      "required": ["as_a", "i_want", "so_that"],
      "additionalProperties": true,
      "properties": {
        "as_a": { "type": "string" },
        "i_want": { "type": "string" },
        "so_that": { "type": "string" }
      }
    },
    "context": { "type": "string" },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scenario_name", "scenario_type", "given", "when", "then"],
        "additionalProperties": true,
        "properties": {
          "scenario_name": { "type": "string" },
          "scenario_type": { "type": "string" },
          "given": { "type": "array", "items": { "type": "string" } },
          "when": { "type": "string" },
          "then": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "banking_grade_concerns": {
      "type": "object",
      "description": "Force-evaluated banking-grade rows (pii_fields, audit_events, idempotency, reversibility, authn_authz, regulatory, tipping_off, ...): each {status: applies|not_applicable|unknown, justification}.",
      "additionalProperties": {
        "type": "object",
        "required": ["status", "justification"],
        "properties": {
          "status": { "type": "string", "enum": ["applies", "not_applicable", "unknown"] },
          "justification": { "type": "string" }
        }
      }
    },
    "priority": { "type": "string" },
    "sizing": { "type": "object" },
    "dependencies": { "type": "object" },
    "dor_checklist": { "type": "object" },
    "requirement_refs": { "type": "array" },
    "open_questions": { "type": "array" },
    "scope_ref": { "type": "string" },
    "change_log": { "type": "array" }
  }
}
