{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "executing-frontend-unit-tests output",
  "type": "object",
  "required": ["verdict", "totals", "audit_id"],
  "additionalProperties": false,
  "properties": {
    "verdict": { "type": "string", "enum": ["PASS", "FAIL", "ERROR"] },
    "totals": {
      "type": "object",
      "required": ["executed", "passed", "failed", "skipped"],
      "additionalProperties": false,
      "properties": {
        "executed": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 }
      }
    },
    "per_file_coverage": {
      "type": "array",
      "description": "Measured per-file coverage from the runner, not self-claimed.",
      "items": {
        "type": "object",
        "required": ["file", "coverage"],
        "additionalProperties": false,
        "properties": {
          "file": { "type": "string" },
          "coverage": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
        }
      }
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["test", "summary"],
        "additionalProperties": false,
        "properties": {
          "test": { "type": "string" },
          "summary": { "type": "string" },
          "repro": { "type": "string" }
        }
      }
    },
    "audit_id": { "type": "string", "format": "uuid" }
  }
}
