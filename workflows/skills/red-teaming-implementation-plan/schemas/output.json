{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "red-teaming-implementation-plan output",
  "type": "object",
  "required": ["verdict", "steelman", "findings", "confidence", "audit_id"],
  "additionalProperties": false,
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["PROCEED", "REVISE", "BLOCK"]
    },
    "steelman": {
      "type": "string",
      "description": "The strongest honest case FOR the plan, written before the findings."
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "category", "claim", "recommendation"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^RT-[0-9]+$" },
          "severity": { "type": "string", "enum": ["high", "medium", "low"] },
          "category": {
            "type": "string",
            "enum": ["requirements", "architecture", "contract", "data", "security", "operability", "cost", "testability"]
          },
          "claim": { "type": "string" },
          "evidence": { "type": "string" },
          "recommendation": { "type": "string" }
        }
      }
    },
    "bias_checks": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Reviewer-bias mitigations applied (self-preference, position/verbosity, hallucinated-flaw, heterogeneity)."
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "audit_id": { "type": "string", "format": "uuid" }
  }
}
