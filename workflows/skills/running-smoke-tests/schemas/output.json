{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "running-smoke-tests output",
  "type": "object",
  "required": [
    "verdict",
    "receipt_id",
    "probes",
    "all_green",
    "execution",
    "audit_id"
  ],
  "additionalProperties": false,
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "ERROR"
      ]
    },
    "probes": {
      "type": "array",
      "description": "Every probe from the receipt's approved smoke manifest \u2014 none silently dropped. Rows carry only normalized, redacted end-state summaries; never response bodies, credentials, or captured identifiers.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "executed",
          "green"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "green": {
            "type": "boolean"
          },
          "latency_ms": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "executed": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "description": "Required (redacted) explanation for a non-green row."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "green": {
                  "const": false
                }
              },
              "required": [
                "green"
              ]
            },
            "then": {
              "required": [
                "reason"
              ]
            }
          }
        ]
      },
      "minItems": 1
    },
    "all_green": {
      "type": "boolean"
    },
    "audit_id": {
      "type": "string",
      "format": "uuid",
      "description": "Producer-stamped provenance id. LIVE derivation: UUIDv5(HOUSE_NS, \"smoke-tests:{idempotency_key}\"), HOUSE_NS = uuid5(NAMESPACE_URL, \"https://squad-delivery/audit\") \u2014 distinct from the per-attempt audit id in events.jsonl. (Reference-corpus ids use the grandfathered corpus convention.)"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1,
      "description": "Echoed UNCHANGED from the input (the S6 handoff receipt) \u2014 binds the smoke evidence to its deployment target."
    },
    "execution": {
      "type": "object",
      "description": "Execution provenance \u2014 replay = byte-verbatim reference corpus (no probe ran); runner = real probes ran.",
      "required": [
        "mode",
        "target_source"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "runner",
            "replay"
          ]
        },
        "target_source": {
          "type": "string",
          "enum": [
            "current-run",
            "reference-corpus"
          ]
        },
        "runner": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        },
        "report_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "runner"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "runner",
              "evidence_ref",
              "report_sha256"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "replay"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "target_source": {
                "const": "reference-corpus"
              }
            }
          }
        }
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "PASS"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "all_green": {
            "const": true
          },
          "probes": {
            "items": {
              "properties": {
                "executed": {
                  "const": true
                },
                "green": {
                  "const": true
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "FAIL"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "properties": {
          "all_green": {
            "const": false
          },
          "probes": {
            "contains": {
              "properties": {
                "executed": {
                  "const": true
                }
              },
              "required": [
                "executed"
              ]
            }
          }
        },
        "anyOf": [
          {
            "properties": {
              "probes": {
                "contains": {
                  "properties": {
                    "green": {
                      "const": false
                    }
                  },
                  "required": [
                    "green"
                  ]
                }
              }
            }
          },
          {
            "properties": {
              "probes": {
                "contains": {
                  "properties": {
                    "executed": {
                      "const": false
                    }
                  },
                  "required": [
                    "executed"
                  ]
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "ERROR"
          }
        },
        "required": [
          "verdict"
        ]
      },
      "then": {
        "required": [
          "errors"
        ],
        "properties": {
          "all_green": {
            "const": false
          },
          "errors": {
            "minItems": 1
          },
          "probes": {
            "not": {
              "contains": {
                "properties": {
                  "executed": {
                    "const": true
                  }
                },
                "required": [
                  "executed"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
