{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "running-performance-load-test output",
  "type": "object",
  "required": ["verdict", "metrics", "within_budget", "audit_id"],
  "additionalProperties": false,
  "properties": {
    "verdict": { "type": "string", "enum": ["PASS", "FAIL", "ERROR"] },
    "metrics": {
      "type": "object",
      "description": "Measured by the load runner, not asserted by an agent.",
      "required": ["p95", "error_rate"],
      "additionalProperties": false,
      "properties": {
        "p95": { "type": ["number", "null"], "minimum": 0, "description": "Observed p95 latency in ms." },
        "p99": { "type": ["number", "null"], "minimum": 0, "description": "Observed p99 latency in ms." },
        "error_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1, "description": "Observed error ratio." },
        "throughput": { "type": ["number", "null"], "minimum": 0, "description": "Observed requests/sec." }
      }
    },
    "within_budget": { "type": "boolean" },
    "breaches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric", "observed", "budget"],
        "additionalProperties": false,
        "properties": {
          "metric": { "type": "string", "enum": ["p95", "p99", "error_rate", "throughput"] },
          "observed": { "type": ["number", "null"] },
          "budget": { "type": ["number", "null"] }
        }
      }
    },
    "audit_id": { "type": "string", "format": "uuid" }
  }
}
