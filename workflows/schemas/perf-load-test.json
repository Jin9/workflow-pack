{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "S-test perf-load-test boundary \u2014 performance/load results",
  "type": "object",
  "required": [
    "verdict",
    "metrics",
    "within_budget",
    "breaches",
    "sample_adequate",
    "execution",
    "audit_id"
  ],
  "additionalProperties": true,
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "ERROR"
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "p95": {
          "type": [
            "number",
            "null"
          ]
        },
        "p99": {
          "type": [
            "number",
            "null"
          ]
        },
        "error_rate": {
          "type": [
            "number",
            "null"
          ]
        },
        "throughput": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "within_budget": {
      "type": "boolean"
    },
    "breaches": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "audit_id": {
      "type": "string",
      "format": "uuid"
    },
    "human_view": {
      "type": "object",
      "description": "Additive render-policy hint for the human-review layer; absence == default (generic tree).",
      "additionalProperties": true,
      "properties": {
        "kind": {
          "type": "string"
        },
        "render": {
          "type": "string",
          "enum": [
            "viewer",
            "native",
            "fold",
            "split",
            "gate-summary"
          ]
        },
        "source": {
          "type": "string"
        },
        "renderer": {
          "type": "string"
        },
        "verdict_map": {
          "type": "object"
        }
      }
    },
    "sample_adequate": {},
    "execution": {}
  },
  "description": "Boundary contract for the perf-load-test gate. Permissive stage boundary; required mirrors the YAML required_fields. Machine-threshold gate: verdict PASS/FAIL/ERROR routes via engine/policies.py; execution records replay vs runner provenance (replay = reference corpus, no scan ran)."
}
