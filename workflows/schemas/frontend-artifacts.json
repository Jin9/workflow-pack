{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://squad-delivery/schemas/frontend-artifacts.json",
  "title": "S4b frontend-implement boundary \u2014 frontend artifacts (implement-frontend-feature output)",
  "description": "Boundary for the S4b frontend-implement node: permissive superset over implement-frontend-feature/schemas/output.json (implementation success variant); required mirrors the YAML required_fields.",
  "type": "object",
  "required": [
    "a11y_compliance",
    "audit_id",
    "files_generated",
    "security_review",
    "tests_generated"
  ],
  "additionalProperties": true,
  "properties": {
    "files_generated": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "content_hash",
          "path",
          "size_bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "content_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "lines_added": {
            "type": "integer",
            "minimum": 1
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "tests_generated": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {},
        "required": [
          "content_hash",
          "path"
        ]
      }
    },
    "a11y_compliance": {
      "type": "object",
      "additionalProperties": true
    },
    "security_review": {
      "type": "object",
      "additionalProperties": true
    },
    "bundle_impact_estimate_kb": {
      "type": "number",
      "minimum": 0
    },
    "audit_id": {
      "type": "string",
      "format": "uuid"
    },
    "human_view": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "kind": {
          "type": "string"
        },
        "render": {
          "type": "string",
          "enum": [
            "viewer",
            "native",
            "fold",
            "split",
            "gate-summary"
          ]
        },
        "source": {
          "type": "string"
        },
        "renderer": {
          "type": "string"
        },
        "verdict_map": {
          "type": "object"
        }
      }
    }
  }
}
