{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "S-test e2e-tests boundary — end-to-end scenario results",
  "type": "object",
  "required": [
    "verdict",
    "scenarios",
    "audit_id"
  ],
  "additionalProperties": false,
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "ERROR"
      ]
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "flaky_rate": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "audit_id": {
      "type": "string",
      "format": "uuid"
    },
    "human_view": {
      "type": "object",
      "description": "Additive render-policy hint for the human-review layer; absence == default (generic tree).",
      "additionalProperties": true,
      "properties": {
        "kind": {
          "type": "string"
        },
        "render": {
          "type": "string",
          "enum": [
            "viewer",
            "native",
            "fold",
            "split",
            "gate-summary"
          ]
        },
        "source": {
          "type": "string"
        },
        "renderer": {
          "type": "string"
        },
        "verdict_map": {
          "type": "object"
        }
      }
    }
  }
}
