{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "S-test backend-unit-tests boundary — unit test results",
  "type": "object",
  "required": ["verdict", "totals", "audit_id"],
  "additionalProperties": false,
  "properties": {
    "verdict": { "type": "string", "enum": ["PASS", "FAIL", "ERROR"] },
    "totals": {
      "type": "object",
      "required": ["executed", "passed", "failed", "skipped"],
      "additionalProperties": false,
      "properties": {
        "executed": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 }
      }
    },
    "coverage_measured": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "failures": { "type": "array", "items": { "type": "object" } },
    "audit_id": { "type": "string", "format": "uuid" }
  }
}
