{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "S-test contract-tests boundary — Pact/CDCT results",
  "type": "object",
  "required": [
    "verdict",
    "can_i_deploy",
    "audit_id"
  ],
  "additionalProperties": false,
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "ERROR"
      ]
    },
    "provider_verified": {
      "type": "boolean"
    },
    "pacts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "can_i_deploy": {
      "type": "boolean"
    },
    "audit_id": {
      "type": "string",
      "format": "uuid"
    },
    "human_view": {
      "type": "object",
      "description": "Additive render-policy hint for the human-review layer; absence == default (generic tree).",
      "additionalProperties": true,
      "properties": {
        "kind": {
          "type": "string"
        },
        "render": {
          "type": "string",
          "enum": [
            "viewer",
            "native",
            "fold",
            "split",
            "gate-summary"
          ]
        },
        "source": {
          "type": "string"
        },
        "renderer": {
          "type": "string"
        },
        "verdict_map": {
          "type": "object"
        }
      }
    }
  }
}
