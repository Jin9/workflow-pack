{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "S-test smoke-tests boundary — post-deploy smoke results",
  "type": "object",
  "required": ["verdict", "probes", "all_green", "audit_id"],
  "additionalProperties": false,
  "properties": {
    "verdict": { "type": "string", "enum": ["PASS", "FAIL", "ERROR"] },
    "probes": { "type": "array", "items": { "type": "object" } },
    "all_green": { "type": "boolean" },
    "audit_id": { "type": "string", "format": "uuid" }
  }
}
