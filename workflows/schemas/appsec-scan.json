{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "S-test appsec-scan boundary \u2014 DAST/SCA/secrets findings",
  "type": "object",
  "required": [
    "verdict",
    "dast_findings",
    "sca_cves",
    "secrets",
    "new_vs_baseline",
    "execution",
    "audit_id"
  ],
  "additionalProperties": true,
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "ERROR"
      ]
    },
    "dast_findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "sca_cves": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "secrets": {
      "type": "integer",
      "minimum": 0
    },
    "audit_id": {
      "type": "string",
      "format": "uuid"
    },
    "human_view": {
      "type": "object",
      "description": "Additive render-policy hint for the human-review layer; absence == default (generic tree).",
      "additionalProperties": true,
      "properties": {
        "kind": {
          "type": "string"
        },
        "render": {
          "type": "string",
          "enum": [
            "viewer",
            "native",
            "fold",
            "split",
            "gate-summary"
          ]
        },
        "source": {
          "type": "string"
        },
        "renderer": {
          "type": "string"
        },
        "verdict_map": {
          "type": "object"
        }
      }
    },
    "new_vs_baseline": {},
    "execution": {}
  },
  "description": "Boundary contract for the appsec-scan gate. Permissive stage boundary; required mirrors the YAML required_fields. Automatic machine gate: PASS completes; FAIL/ERROR retry once then the named-human queue; execution records replay vs runner provenance (replay = reference corpus, no scanner ran)."
}
