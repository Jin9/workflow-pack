{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "S-test integration-tests boundary — integration results",
  "type": "object",
  "required": [
    "verdict",
    "totals",
    "teardown_ok",
    "defects",
    "execution",
    "audit_id"
  ],
  "additionalProperties": true,
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "ERROR"
      ]
    },
    "totals": {
      "type": "object",
      "required": [
        "executed",
        "passed",
        "failed",
        "skipped"
      ],
      "additionalProperties": false,
      "properties": {
        "executed": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "teardown_ok": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Null only under ERROR."
    },
    "defects": {
      "type": "array",
      "description": "Required; [] when no defects; items carry severity/summary/repro."
    },
    "audit_id": {
      "type": "string",
      "format": "uuid"
    },
    "human_view": {
      "type": "object",
      "description": "Additive render-policy hint for the human-review layer; absence == default (generic tree).",
      "additionalProperties": true,
      "properties": {
        "kind": {
          "type": "string"
        },
        "render": {
          "type": "string",
          "enum": [
            "viewer",
            "native",
            "fold",
            "split",
            "gate-summary"
          ]
        },
        "source": {
          "type": "string"
        },
        "renderer": {
          "type": "string"
        },
        "verdict_map": {
          "type": "object"
        }
      }
    },
    "execution": {
      "type": "object",
      "description": "Execution provenance: replay (corpus evidence) vs runner (live SIT)."
    },
    "errors": {
      "type": "array",
      "description": "Non-empty under ERROR."
    }
  },
  "description": "Permissive stage boundary: superset envelope over the skill's strict output schema; required mirrors the YAML required_fields."
}
