{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "T12 canary-analysis boundary — multi-window canary verdict",
  "type": "object",
  "required": [
    "verdict",
    "per_metric",
    "sample_adequate",
    "windows_passed",
    "audit_id"
  ],
  "additionalProperties": true,
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "promote",
        "hold",
        "rollback"
      ]
    },
    "per_metric": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "sample_adequate": {
      "type": "boolean"
    },
    "windows_passed": {
      "type": "integer",
      "minimum": 0
    },
    "audit_id": {
      "type": "string",
      "format": "uuid"
    },
    "human_view": {
      "type": "object",
      "description": "Additive render-policy hint for the human-review layer; absence == default (generic tree).",
      "additionalProperties": true,
      "properties": {
        "kind": {
          "type": "string"
        },
        "render": {
          "type": "string",
          "enum": [
            "viewer",
            "native",
            "fold",
            "split",
            "gate-summary"
          ]
        },
        "source": {
          "type": "string"
        },
        "renderer": {
          "type": "string"
        },
        "verdict_map": {
          "type": "object"
        }
      }
    }
  },
  "description": "Permissive stage boundary: superset envelope over the skill's strict output schema; required mirrors the YAML required_fields."
}
