{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dashboard-data.schema.json",
  "title": "Squad Delivery Dashboard data contract",
  "description": "Authoritative source of the dashboard DATA module. build.py regenerates the module (TIER, stages, EVENTS, TEMPLATES, JSON_ONLY, tests, skillmap) plus the 3 verbatim merge statements from this file. Stages are RAW: the merge-derived keys (consumes, emits, sdlc, template, fmt, jsonOnly) must NOT appear on a stage. Cross-reference rules (events/templates keys must equal stage ids; json_only must be a subset of stage ids) and the offline rule (no live URLs) are enforced by build.py, not expressible here.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tier", "stages", "events", "templates", "json_only", "tests", "skillmap"],
  "properties": {
    "tier": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/stage" }
    },
    "events": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/event" }
    },
    "templates": {
      "type": "object",
      "additionalProperties": { "$ref": "#/definitions/template" }
    },
    "json_only": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "tests": {
      "type": "array",
      "items": { "$ref": "#/definitions/test" }
    },
    "skillmap": {
      "type": "array",
      "items": { "$ref": "#/definitions/skill" }
    }
  },
  "definitions": {
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "skill", "owner", "model", "tier", "gate", "input",
        "output", "contract", "json", "verify", "reviewDoc", "caps", "schema",
        "fail", "tip"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "skill": { "type": "string" },
        "owner": { "type": "string" },
        "model": { "type": "string" },
        "tier": { "type": "string", "enum": ["T1", "T2", "T3"] },
        "gate": { "type": "string", "enum": ["auto", "async", "sync", "gate", "auto+exc", "human"] },
        "input": { "type": "string" },
        "output": { "type": "string" },
        "contract": { "type": "string" },
        "json": { "type": "string", "enum": ["full", "manifest"] },
        "verify": { "type": "boolean" },
        "reviewDoc": { "type": "string" },
        "caps": { "type": "string" },
        "schema": { "type": "string" },
        "fail": { "type": "string" },
        "tip": { "type": "string" },
        "deferred": { "type": "boolean" }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consumes", "emits", "sdlc"],
      "properties": {
        "consumes": { "type": "array", "items": { "type": "string" } },
        "emits": { "type": "string" },
        "sdlc": { "type": "string", "minLength": 1 }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p", "f"],
      "properties": {
        "p": { "type": "string" },
        "f": { "type": "string" }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "level", "on", "runner", "metric", "threshold", "gate", "note"],
      "properties": {
        "name": { "type": "string" },
        "level": { "type": "string", "minLength": 1 },
        "on": { "type": "string" },
        "runner": { "type": "string" },
        "metric": { "type": "string" },
        "threshold": { "type": "string" },
        "gate": { "type": "string", "enum": ["auto", "auto+exc", "human"] },
        "note": { "type": "string" },
        "star": { "type": "boolean" }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "skill", "cov", "missing", "src", "cite"],
      "properties": {
        "step": { "type": "string" },
        "skill": { "type": "string" },
        "cov": { "type": "string", "enum": ["full", "partial", "none"] },
        "missing": { "type": "string" },
        "src": { "type": "string", "enum": ["live", "vault", "draft", "unbuilt", "removed", "web"] },
        "cite": { "type": "string" }
      }
    }
  }
}
